{
  "name": "ks-informatique",
  "version": "1.0.0",
  "description": "Application Windows KS INFORMATIQUE",
  "main": "main.cjs",
  "author": "KS INFORMATIQUE",
  "scripts": {
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^39.2.7",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "gn.ksinformatique.desktop",
    "productName": "KS INFORMATIQUE",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.cjs"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}